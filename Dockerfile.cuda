FROM cuda-ubuntu:22.04-dev

# Build-time proxy configuration (pass via: --build-arg USE_INTERNAL_CACHE=true)
ARG USE_INTERNAL_CACHE=false
ARG HTTP_PROXY_HOST=172.16.195.148
ARG HTTP_PROXY_PORT=8118
ARG NEXUS_HOST=172.16.240.100
ARG NEXUS_PORT=8081
ARG APT_CACHE_HOST=172.16.240.100
ARG APT_CACHE_PORT=3142

# ---------- APT ----------
RUN if [ "$USE_INTERNAL_CACHE" = "true" ]; then \
      echo "Using internal apt-cacher-ng: http://${APT_CACHE_HOST}:${APT_CACHE_PORT}"; \
      echo "Acquire::http::Proxy \"http://${APT_CACHE_HOST}:${APT_CACHE_PORT}\";" > /etc/apt/apt.conf.d/02proxy; \
      sed -i 's|https://mirrors.aliyun.com|http://mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    curl \
    git \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/apt/apt.conf.d/02proxy

# ---------- Node.js 20.x ----------
RUN if [ "$USE_INTERNAL_CACHE" = "true" ]; then \
      export http_proxy="http://${HTTP_PROXY_HOST}:${HTTP_PROXY_PORT}"; \
      export https_proxy="http://${HTTP_PROXY_HOST}:${HTTP_PROXY_PORT}"; \
    else \
      export http_proxy=""; export https_proxy=""; \
    fi; \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---------- pip ----------
RUN mkdir -p /root/.config/pip && \
    if [ "$USE_INTERNAL_CACHE" = "true" ]; then \
      printf '[global]\nindex-url = http://%s:%s/repository/pypi-proxy/simple/\ntrusted-host = %s\ntimeout = 600\n' \
        "$NEXUS_HOST" "$NEXUS_PORT" "$NEXUS_HOST" > /root/.config/pip/pip.conf; \
    else \
      printf '[global]\nindex-url = http://mirrors.aliyun.com/pypi/simple/\ntrusted-host = mirrors.aliyun.com\ntimeout = 600\n' > /root/.config/pip/pip.conf; \
    fi

COPY backend/requirements.txt /app/backend/requirements.txt

# torch/torchaudio (PyTorch CUDA wheels)
RUN if [ "$USE_INTERNAL_CACHE" = "true" ]; then \
      pip3 install --no-deps \
        --extra-index-url "http://${NEXUS_HOST}:${NEXUS_PORT}/repository/pytorch-proxy/simple/" \
        torch==2.4.1+cu124 torchaudio==2.4.1+cu124; \
    else \
      pip3 install --no-deps \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.4.1+cu124 torchaudio==2.4.1+cu124; \
    fi

# Remaining Python deps
RUN pip3 install \
    fastapi>=0.104.0 \
    uvicorn>=0.24.0 \
    sqlalchemy>=2.0.0 \
    python-multipart>=0.0.6 \
    ebooklib>=0.18 \
    PyMuPDF>=1.23.0 \
    beautifulsoup4>=4.12.0 \
    mutagen>=1.47.0 \
    pytest>=7.4.0 \
    httpx>=0.25.0 \
    PyJWT>=2.8.0 \
    mobi>=0.4.0 \
    omnivoice

# ---------- npm ----------
COPY frontend/package.json /app/frontend/package.json
RUN if [ "$USE_INTERNAL_CACHE" = "true" ]; then \
      cd /app/frontend && npm config set registry "http://${NEXUS_HOST}:${NEXUS_PORT}/repository/npm-proxy/" && npm install; \
    else \
      cd /app/frontend && npm config set registry "http://registry.npmmirror.com" && npm install; \
    fi

COPY . /app

RUN mkdir -p /app/data/books /app/data/audio /app/data/reference

ENV PYTHONPATH=/app/backend

EXPOSE 8000 5173

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
